---
import "styles/2048.css";
import MainLayout from "layouts/Main.astro";
---

<MainLayout
    title="32768: The Unlimited Motchiy++ - Play on Heiki!"
    ,description="クラシックな2048ゲームを、すべて4倍に拡張した超ワイドゲーム！さらなる『混沌』を味わおう。"
    ,tags="ミニゲーム,HTML"
>
    <body>
        <h1>32768: The Unlimted Motchiy++</h1>
        <div>
            Score: <span id="score">0</span> | High Score:{" "}
            <span id="high-score">0</span>
        </div>
        <button onclick="newGame()">New Game</button>
        <div
            id="game-board"
            style="
display: grid;
grid-template-columns: repeat(16, 1fr);
grid-template-rows: repeat(16, 1fr);
border: 1px solid black;
width: 400px;
height: 400px;
position: relative;"
        ></div>
        <div
            id="game-over-overlay"
            style="display: none; position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.7); color: white; display: flex; flex-direction: column; justify-content: center; align-items: center; z-index: 100;"
        >
            <h2>Game Over!</h2>
            <p>
                Your Score: <span id="final-score">0</span>
            </p>
            <button
                onclick="newGame()"
                style="padding: 10px 20px; font-size: 18px; cursor: pointer;"
            >
                Play Again
            </button>
        </div>
        <br />
        <button onclick="location.href='/2048.html'">Also play 2048!</button>
    </body>
    <script src="/32768.js" defer></script>
</MainLayout>
