---
import "styles/2048.css";
import MainLayout from "layouts/Main.astro";
---

<MainLayout
    title="2048: The Unlimited Motchiy - Play on Heiki!"
    ,
    description="思考力の試される、シンプルでベストな2048パズル！初心者からやり込み勢まで楽しめる、クラシックなゲーム体験を！"
>
    <div class="documents-container">
        <h1>2048: The Unlimted Motchiy</h1>
        <div>
            Score: <span id="score">0</span> | High Score:{" "}
            <span id="high-score">0</span>
        </div>
        <button onclick="newGame()">New Game</button>
        <div
            id="game-board"
            style="display: grid; grid-template-columns: repeat(4, 100px); grid-template-rows: repeat(4, 100px); border: 1px solid black; width: 400px; height: 400px; position: relative;"
        ></div>
        <div
            id="game-over-overlay"
            style="display: none; position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.7); color: white; display: flex; flex-direction: column; justify-content: center; align-items: center; z-index: 100;"
        >
            <h2>Game Over!</h2>
            <p>
                Your Score: <span id="final-score">0</span>
            </p>
            <button
                onclick="newGame()"
                style="padding: 10px 20px; font-size: 18px; cursor: pointer;"
            >
                Play Again
            </button>
        </div>
        <br />
        <button onclick="location.href='/32768.html'">Also play 32768!</button>
    </div>
    <script src="/2048.js" defer></script>
</MainLayout>
