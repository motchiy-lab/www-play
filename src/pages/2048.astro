---
import "styles/2048.css";
import MainLayout from "layouts/Main.astro";
---

<MainLayout
    title="2048: The Unlimited Motchiy - Play on Heiki!"
    description="思考力の試される、シンプルでベストな2048パズル！初心者からやり込み勢まで楽しめる、クラシックなゲーム体験を！"
    tags="ミニゲーム,HTML"
    pageClass="game-2048-page"
>
    <main class="documents-container">
        <h1>2048: The Unlimited Motchiy</h1>
        <div>
            Score: <span id="score">0</span> | High Score:{" "}
            <span id="high-score">0</span>
        </div>
        <button onclick="newGame()">New Game</button>
        <div class="game-board-shell">
            <div id="game-board" class="game-board game-board--2048"></div>
        </div>
        <div id="game-over-overlay" class="game-over-overlay">
            <h2>Game Over!</h2>
            <p>
                Your Score: <span id="final-score">0</span>
            </p>
            <button onclick="newGame()" class="game-over-retry">
                Play Again
            </button>
        </div>
        <br />
        <a class="game-link" href="/32768/">Also play 32768!</a>
    </main>
    <script is:inline src="/2048.js"></script>
</MainLayout>
