function formatNumber(n){

n=BigInt(n)

const units=[
[10n**68n,"無量大数"],
[10n**64n,"不可思議"],
[10n**60n,"那由他"],
[10n**56n,"阿僧祇"],
[10n**52n,"恒河沙"],
[10n**48n,"極"],
[10n**44n,"載"],
[10n**40n,"正"],
[10n**36n,"澗"],
[10n**32n,"溝"],
[10n**28n,"穣"],
[10n**24n,"秭"],
[10n**20n,"垓"],
[10n**16n,"京"],
[10n**12n,"兆"],
[10n**8n,"億"],
[10n**4n,"万"]
];

for(const u of units){

if(n>=u[0]){

let val=Number(n/(u[0]/100n))/100
return val+u[1]

}

}

return n.toString()

}

