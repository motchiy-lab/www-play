function buyBuilding(i){

let b=game.buildings[i]

if(game.cookies<b.cost){
toast("餅不足🥹")
return
}

game.cookies-=b.cost
b.owned++
b.cost=(b.cost*115n+50n)/100n
toast("Bought "+innerHTMLRemoving(b.name))
checkAchievements()

render()

}

function buyItem(i){

let it=game.items[i]

