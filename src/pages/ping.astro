---
import MainLayout from "layouts/Main.astro";
import "styles/ping.css";
---

<MainLayout title="Pingチェッカー - Play on Heiki!" description="いくつかのサイトにお使いの端末からpingを送信し、レイテンシをチェックします。" tags="ping,通信速度" pageClass="ping-page">
    <main class="documents-container">
        <h1>Pingチェッカー</h1>
        <nav class="site-grid" aria-label="サイトリスト">
            <div class="site-card">
                <span class="site-card__title">Motchiy Server</span>
                <span class="site-card__address">motchiy.com</span>
                <span class="site-card__speed">0 ms</span>
            </div>
            <div class="site-card">
                <span class="site-card__title">Google</span>
                <span class="site-card__address">google.com</span>
                <span class="site-card__speed">0 ms</span>
            </div>
            <div class="site-card">
                <span class="site-card__title">Bing</span>
                <span class="site-card__address">bing.com</span>
                <span class="site-card__speed">0 ms</span>
            </div>
        </nav>
    </main>
    <script src="/ping.js" defer></script>
</MainLayout>
