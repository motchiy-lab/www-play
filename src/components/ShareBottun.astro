---
import { Image } from "astro:assets";

// components/ShareButtons.astro
// 現在のページのURLとタイトルを取得（またはPropsで受け取る）
const url = Astro.url.href;
const title = Astro.props.title || "ページのタイトル";

// 各SNSのシェア用URLを構築
const twitterUrl = `https://twitter.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(title)}`;
const facebookUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`;
const lineUrl = `https://social-plugins.line.me/lineit/share?url=${encodeURIComponent(url)}`;
---

<nav class="share-buttons">
    <a href={twitterUrl} class="share-btn twitter" rel="noopener noreferrer">
        <Image
            src="https://cdn.jsdelivr.net/gh/simple-icons/simple-icons/icons/twitter.svg"
            alt="Twitterアイコン"
            width={18}
            height={18}
        />
        Twitterで共有
    </a>
    <a href={facebookUrl} class="share-btn facebook" rel="noopener noreferrer">
        <Image
            src="https://cdn.jsdelivr.net/gh/simple-icons/simple-icons/icons/facebook.svg"
            alt="Facebookアイコン"
            width={18}
            height={18}
        />
        Facebookで共有
    </a>
    <a href={lineUrl} class="share-btn line" rel="noopener noreferrer">
        <Image
            src="https://cdn.jsdelivr.net/gh/simple-icons/simple-icons/icons/line.svg"
            alt="LINEアイコン"
            width={18}
            height={18}
        />
        LINEで共有
    </a>
</nav>
