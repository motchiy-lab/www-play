---
import MainLayout from "../layouts/Main.astro";
import "../styles/portal.css";

interface Props {
    pageTitle: string;
    description: string;
    heading: string;
    image: string;
    imageAlt: string;
    pictureLink: string;
}

const { pageTitle, description, canonicalPath, heading, image, imageAlt, pictureLink } =
    Astro.props;
---

<MainLayout
    title={pageTitle}
    description={description}
    canonicalPath={canonicalPath}
>
    <div class="documents-container">
        <h1 class="headline">{heading}</h1>
        <a href={pictureLink}>
            <img src={image} class="thumbnail" alt={imageAlt} />
        </a>
        <slot />
    </div>
</MainLayout>
